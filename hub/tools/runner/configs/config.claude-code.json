{
  "_说明": "Claude Code 一档。已在作者的环境里真实接过一张卡。所有路径是占位，请改成你自己的。",
  "identity": "claude-code",
  "board": {
    "cli": ["/path/to/node", "/path/to/hub/packages/hub-bff/bin/hub-handoff.mjs"],
    "configFile": "~/.dsh-runner/board-claude-code.json",
    "useOpen": true
  },
  "stateDir": "~/.dsh-runner/state-claude-code",
  "workRoot": "~/.dsh-runner/work-claude-code",
  "maxPerRun": 1,
  "dailyLimit": 10,
  "timeoutSec": 600,
  "triageTimeoutSec": 60,
  "denyPattern": "付款|支付|转账|汇款|收款|发邮件|发送邮件|群发|对外发送|删除|清空|密钥|令牌|token|密码|api[ _-]?key",
  "rules": [{ "tier": "default", "match": "【简单】|【复杂】|档:\\s*default" }],
  "envPass": ["PATH", "HOME", "LANG", "TMPDIR", "USER", "SHELL"],
  "tiers": {
    "default": {
      "model": "sonnet",
      "cmd": ["/path/to/claude", "-p", "--model", "sonnet", "--permission-mode", "acceptEdits", "--tools", "Read,Write,Edit,Glob,Grep,Bash", "--allowedTools", "Bash(ls:*)", "--no-session-persistence"]
    }
  },
  "triage": null
}
