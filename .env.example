# 环境变量样例（全部是占位值）。本项目的程序直接读环境变量，不会自动读 .env；
# 用法：复制成 .env，填好，然后  set -a; . ./.env; set +a  再启动。.env 已在 .gitignore 里，不要提交。
# 令牌、密钥一律放文件（权限 0600）再用 *_FILE 指过去，不要写进命令行参数。

# —— 通用 ——
HUB_HOME=/absolute/path/to/your/run-dir        # 运行目录（助理目录、配置、工单、账本都在里面）

# —— hub-bff（接 DSH 内核的服务）——
DSH_URL=http://127.0.0.1:3290                  # 你的 DSH 内核地址
DSH_TOKEN_FILE=/absolute/path/to/dsh.token     # 内核连接令牌所在文件，0600
BFF_KEY_FILE=/absolute/path/to/bff.key         # 后端钥匙文件，0600；web 层转发时带它
BFF_PORT=3291                                  # 只听 127.0.0.1

# —— hub-web（网页服务与适配层）——
HUB_WEB_HOSTS=127.0.0.1                        # 只写明确的 IP；拒绝 0.0.0.0
HUB_WEB_PORT=3292
HUB_WEB_KEY_FILE=/absolute/path/to/hub-web.key # 首次访问用 ?key= 换 cookie，0600
BFF_URL=http://127.0.0.1:3291

# —— 你自己的模型（写进你的 DSH 配置，不是本项目读取）——
# 例：在 DSH 配置里 apiKeyEnv: MY_MODEL_API_KEY，再在启动 DSH 的 shell 里设置它
MY_MODEL_API_KEY=replace-me

# —— 看板给外部 agent（外部 agent 那一侧设置）——
HUB_BOARD_URL=http://127.0.0.1:3291/board
HUB_BOARD_TOKEN=replace-me                     # 只设环境变量，别写进命令行
